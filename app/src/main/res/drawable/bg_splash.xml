<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-start window background: flat brand surface, no flash of white.
    Uses @color rather than ?attr so it resolves before the theme is applied;
    values-night/colors.xml supplies the dark variant.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/md_surface" />
    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo" />
    </item>
</layer-list>
