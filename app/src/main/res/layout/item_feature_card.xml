<?xml version="1.0" encoding="utf-8"?>
<!--
    One dashboard service: tinted icon tile, title, one line of explanation.
    Included four times on the patient dashboard and configured from code, so
    the four entries cannot drift apart visually.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feature_card"
    style="@style/Widget.VitaCare.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <ImageView
            android:id="@+id/feature_icon"
            android:layout_width="@dimen/icon_tile"
            android:layout_height="@dimen/icon_tile"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_md"
            tools:src="@drawable/ic_stethoscope_24"
            tools:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="@string/feature_find_specialist" />

            <TextView
                android:id="@+id/feature_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/feature_find_specialist_detail" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right_24" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
