<?xml version="1.0" encoding="utf-8"?>
<!--
    Doctor dashboard.

    There was no such screen before: DoctorDashboard was the add-practice form
    itself, so a doctor had no way to see whether they were listed, no way to
    edit what they had published, and no sign-out. It also let them submit the
    same form repeatedly, adding a new duplicate listing each time.

    This screen shows the current state of their listing and offers the two
    actions that follow from it.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        style="@style/Widget.VitaCare.AppBarLayout">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.VitaCare.Toolbar"
            app:menu="@menu/menu_doctor_home"
            app:navigationIcon="@null"
            app:title="@string/doctor_home_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            style="@style/Widget.VitaCare.ContentColumn"
            android:paddingTop="@dimen/space_sm">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Hello, Dr. Rahman" />

            <!-- Status of the public listing. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_card"
                style="@style/Widget.VitaCare.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="@dimen/icon_tile"
                        android:layout_height="@dimen/icon_tile"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_md"
                        tools:src="@drawable/ic_verified_24"
                        tools:tint="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/status_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="@string/doctor_home_listed_title" />

                    <TextView
                        android:id="@+id/status_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="@string/doctor_home_no_profile_body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primary_action"
                        style="@style/Widget.VitaCare.Button.Primary"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        tools:text="@string/doctor_home_publish" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/secondary_action"
                        style="@style/Widget.VitaCare.Button.Outlined.Tall"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/doctor_home_preview"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Published details, shown once a profile exists. -->
            <LinearLayout
                android:id="@+id/profile_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.VitaCare.SectionHeader"
                    android:text="@string/doctor_form_heading" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.VitaCare.Card.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="?android:attr/listDivider"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <include
                            android:id="@+id/row_specialty"
                            layout="@layout/item_info_row" />

                        <include
                            android:id="@+id/row_focus"
                            layout="@layout/item_info_row" />

                        <include
                            android:id="@+id/row_degree"
                            layout="@layout/item_info_row" />

                        <include
                            android:id="@+id/row_contact"
                            layout="@layout/item_info_row" />

                        <include
                            android:id="@+id/row_chamber"
                            layout="@layout/item_info_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.example.vitacare_app_250.ui.common.StateView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="200dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
