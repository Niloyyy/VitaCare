<?xml version="1.0" encoding="utf-8"?>
<!--
    Landing screen. Replaces two unlabelled coloured buttons on a flat coral
    background with a branded introduction and two role cards that say what
    each choice leads to, so the decision can be made without guessing.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_xxl"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xxl">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:layout_marginTop="@dimen/space_xl"
            android:contentDescription="@string/landing_logo_description"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:shapeAppearance="@style/ShapeAppearance.VitaCare.Circle"
            app:strokeColor="?attr/colorPrimaryContainer"
            app:strokeWidth="3dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:text="@string/landing_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/landing_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/landing_choose_role"
            android:textAppearance="@style/TextAppearance.VitaCare.SectionHeader" />

        <!-- Patient route -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_patient"
            style="@style/Widget.VitaCare.Card.Interactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="@dimen/icon_tile"
                    android:layout_height="@dimen/icon_tile"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_person_24"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/landing_join_patient"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/landing_join_patient_detail"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Doctor route -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_doctor"
            style="@style/Widget.VitaCare.Card.Interactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="@dimen/icon_tile"
                    android:layout_height="@dimen/icon_tile"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="?attr/colorTertiaryContainer"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_stethoscope_24"
                    app:tint="?attr/colorOnTertiaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/landing_join_doctor"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/landing_join_doctor_detail"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/app_tagline"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
