<?xml version="1.0" encoding="utf-8"?>
<!--
    Contents of StateView. Merged into the StateView FrameLayout, so this file
    declares only the children.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/state_progress"
        style="@style/Widget.VitaCare.ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorSize="40dp"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/state_message_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingEnd="@dimen/space_xxl"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/state_icon"
            android:layout_width="@dimen/empty_state_icon"
            android:layout_height="@dimen/empty_state_icon"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_empty_search_48" />

        <TextView
            android:id="@+id/state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="No matching doctors" />

        <TextView
            android:id="@+id/state_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Nothing matched that search. Try a different spelling." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/state_action"
            style="@style/Widget.VitaCare.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            tools:text="@string/action_retry"
            tools:visibility="visible" />
    </LinearLayout>

</merge>
