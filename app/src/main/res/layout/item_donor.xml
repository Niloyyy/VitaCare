<?xml version="1.0" encoding="utf-8"?>
<!--
    A donor. The blood group leads as a badge — it is the field people scan for
    — and calling is a direct action on the row rather than a number to copy
    out by hand.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.VitaCare.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/blood_group"
            android:layout_width="@dimen/blood_group_badge"
            android:layout_height="@dimen/blood_group_badge"
            android:background="@drawable/bg_blood_group_badge"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.VitaCare.BloodGroup"
            android:textColor="@color/brand_on_blood_container"
            tools:text="AB+" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Ayesha Rahman" />

            <TextView
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:drawablePadding="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_location_24"
                tools:text="Dhanmondi, Dhaka" />

            <TextView
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="01712345678" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/call"
            style="@style/Widget.VitaCare.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/action_call"
            app:icon="@drawable/ic_phone_24" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
