<?xml version="1.0" encoding="utf-8"?>
<!--
    Patient profile.

    Replaces three white TextViews positioned by percentage bias, each showing
    a hardcoded "Email: " prefix concatenated to the value in Java. Labels and
    values are now separate views, so the label reads as a label to a screen
    reader and the value can be selected and copied.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        style="@style/Widget.VitaCare.AppBarLayout">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.VitaCare.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            style="@style/Widget.VitaCare.ContentColumn"
            android:gravity="center_horizontal"
            android:paddingTop="@dimen/space_lg">

            <ImageView
                android:layout_width="@dimen/avatar_lg"
                android:layout_height="@dimen/avatar_lg"
                android:contentDescription="@string/profile_avatar_description"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/display_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Ayesha Rahman" />

            <com.google.android.material.chip.Chip
                android:id="@+id/role_chip"
                style="@style/Widget.VitaCare.Chip.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/profile_role_patient" />

            <TextView
                style="@style/Widget.VitaCare.SectionHeader"
                android:text="@string/profile_account_section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VitaCare.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/listDivider"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/row_email"
                        layout="@layout/item_info_row" />

                    <include
                        android:id="@+id/row_phone"
                        layout="@layout/item_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sign_out"
                style="@style/Widget.VitaCare.Button.Outlined.Tall"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/action_sign_out"
                android:theme="@style/ThemeOverlay.VitaCare.Danger"
                app:icon="@drawable/ic_logout_24"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
