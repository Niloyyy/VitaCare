<?xml version="1.0" encoding="utf-8"?>
<!--
    Find a donor.

    Replaces a TableLayout that was populated by constructing TextViews in Java
    and appending them as TableRows, with a hand-drawn 2px View between each.
    Nothing recycled, every filter change rebuilt every row, the columns
    overflowed on a phone-width screen, and the whole thing sat in a ScrollView
    positioned by a fixed 190dp guideline that overlapped the filters as soon as
    the font scale went up.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        style="@style/Widget.VitaCare.AppBarLayout">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.VitaCare.Toolbar" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/search_layout"
            style="@style/Widget.VitaCare.TextInputLayout.Search"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:layout_marginBottom="@dimen/space_md">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search"
                style="@style/Widget.VitaCare.TextInputEditText.Search"
                android:hint="@string/find_donor_search_hint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Horizontally scrolling single-select filter, so all nine options
             stay reachable at any font scale. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/group_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/find_donor_group_filter_description"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/result_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.VitaCare.SectionHeader"
            tools:text="8 donors" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:scrollbars="vertical"
            tools:itemCount="4"
            tools:listitem="@layout/item_donor" />

        <com.example.vitacare_app_250.ui.common.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
