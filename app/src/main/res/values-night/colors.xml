<?xml version="1.0" encoding="utf-8"?>
<!--
    VitaCare colour tokens — dark scheme.

    Same token names as values/colors.xml, retuned for dark surfaces: hues are
    lightened and desaturated so they clear the 4.5:1 contrast bar against the
    dark neutrals, and containers become dim tonal fills rather than pastels.
-->
