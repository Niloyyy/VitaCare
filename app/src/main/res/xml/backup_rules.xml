<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30 and below.

    The session store holds the signed-in user's role and uid. Backing that up
    to the cloud and restoring it onto a different device would resurrect a
    session that Firebase Auth no longer recognises, so it is excluded.
    Firebase Auth keeps its own credential store, which is likewise excluded.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="vitacare_session.xml" />
    <exclude
        domain="sharedpref"
        path="com.google.firebase.auth.api.Store.xml" />
</full-backup-content>
