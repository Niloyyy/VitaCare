<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / device-transfer rules for API 31 and above.
    See backup_rules.xml for the rationale behind the exclusions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="vitacare_session.xml" />
        <exclude
            domain="sharedpref"
            path="com.google.firebase.auth.api.Store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="vitacare_session.xml" />
        <exclude
            domain="sharedpref"
            path="com.google.firebase.auth.api.Store.xml" />
    </device-transfer>
</data-extraction-rules>
