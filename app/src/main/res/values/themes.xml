<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        The single application theme. Every colour, shape and type decision in
        VitaCare resolves through here, so a screen only ever refers to
        semantic attributes (?attr/colorPrimary, ?attr/textAppearanceTitleLarge)
        and never to a literal value. values-night/themes.xml overrides only
        what genuinely differs in dark mode.
    -->
    <style name="Base.Theme.VitaCare" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ========================= Colour roles ======================== -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="android:colorControlHighlight">@color/md_outline_variant</item>
        <item name="scrimBackground">@color/md_scrim</item>

        <!-- ============================ Shape ============================ -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.VitaCare.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.VitaCare.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.VitaCare.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.VitaCare.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.VitaCare.ExtraLarge</item>

        <!-- ======================== Type overrides ======================= -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.VitaCare.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.VitaCare.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.VitaCare.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.VitaCare.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.VitaCare.TitleMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.VitaCare.LabelLarge</item>

        <!-- ====================== Component defaults ===================== -->
        <item name="materialButtonStyle">@style/Widget.VitaCare.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.VitaCare.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.VitaCare.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.VitaCare.Card</item>
        <item name="textInputStyle">@style/Widget.VitaCare.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.VitaCare.Toolbar</item>
        <item name="chipStyle">@style/Widget.VitaCare.Chip</item>
        <item name="snackbarStyle">@style/Widget.VitaCare.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.VitaCare.Snackbar.Button</item>
        <item name="snackbarTextViewStyle">@style/Widget.VitaCare.Snackbar.TextView</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.VitaCare.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VitaCare.AlertDialog</item>

        <!-- ========================= System bars ========================= -->
        <!--
            The app draws edge-to-edge and applies window insets itself
            (BaseActivity.applyEdgeToEdgeInsets), so the bars are transparent
            and the icon contrast is driven by the light/dark scheme.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>

        <!-- Cross-activity transition, applied globally rather than per-screen. -->
        <item name="android:windowAnimationStyle">@style/Animation.VitaCare.Activity</item>
    </style>

    <style name="Theme.VitaCare" parent="Base.Theme.VitaCare" />

    <!--
        Launch theme. Paints the branded background before the first frame so
        cold start does not flash the default window background. LandingActivity
        swaps back to Theme.VitaCare in onCreate().
    -->
    <style name="Theme.VitaCare.Splash" parent="Theme.VitaCare">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- ===================== Theme overlays ===================== -->


    <style name="ThemeOverlay.VitaCare.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.VitaCare.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.VitaCare.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.VitaCare.ExtraLarge</item>
    </style>

    <!-- Turns a normal button into the destructive/blood-donation variant. -->
    <style name="ThemeOverlay.VitaCare.Danger" parent="">
        <item name="colorPrimary">@color/brand_blood</item>
        <item name="colorOnPrimary">@color/md_on_error</item>
        <item name="colorPrimaryContainer">@color/brand_blood_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_blood_container</item>
    </style>

    <style name="Animation.VitaCare.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>
