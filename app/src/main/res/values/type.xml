<?xml version="1.0" encoding="utf-8"?>
<!--
    Type scale.

    Deliberately narrow: five roles cover every screen. Sizes are in sp so they
    honour the user's font-size setting; line heights are set explicitly
    because Material's defaults are tuned for shorter Latin strings than the
    clinical labels used here.
-->
<resources>

    <!-- Screen-defining number or single word. Used once per screen at most. -->
    <style name="TextAppearance.VitaCare.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">40sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Welcome / hero headings on auth and landing screens. -->
    <style name="TextAppearance.VitaCare.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="lineHeight">34sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Section headings inside a scrolling screen. -->
    <style name="TextAppearance.VitaCare.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- App bar titles and card titles. -->
    <style name="TextAppearance.VitaCare.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">26sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- List-item primary text. -->
    <style name="TextAppearance.VitaCare.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">22sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Button and chip text. -->
    <style name="TextAppearance.VitaCare.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!--
        Tabular figures for bed / ICU counts so that columns of numbers line up
        instead of jittering as digits change width.
    -->
    <style name="TextAppearance.VitaCare.Metric" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- The blood-group badge: short, bold, always uppercase. -->
    <style name="TextAppearance.VitaCare.BloodGroup" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
